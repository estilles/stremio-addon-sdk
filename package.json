  "homepage": "https://github.com/Stremio/stremio-addon-sdk#readme",
  "dependencies": {
    "chalk": "^5.6.2",
    "cors": "^2.8.6",
    "express": "^4.16.3",
    "inquirer": "^13.4.2",
    "mkdirp": "^3.0.1",
    "node-fetch": "^3.3.2",
    "opn": "^5.5.0",
    "router": "^1.3.3",
    "stremio-addon-linter": "^1.7.0"
  },
  "devDependencies": {
    "eslint": "^5.13.0",
